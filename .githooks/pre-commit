#!/bin/sh
# Git secrets pre-commit hook

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

echo "${YELLOW}Running git-secrets check...${NC}"

# Check for common secret patterns
if git diff --cached | grep -E "password\s*=|api[_-]?key\s*=|secret\s*=|AKIA[0-9A-Z]{16}|-----BEGIN.*PRIVATE KEY" > /dev/null; then
  echo "${RED}Error: Potential secret detected in staged changes!${NC}"
  echo "${YELLOW}Please review your changes and remove any secrets.${NC}"
  exit 1
fi

echo "${GREEN}No secrets detected.${NC}"
exit 0
