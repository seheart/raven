# Raven Configuration Example
# Copy this file to .env and customize for your environment

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server Port (default: 9100)
PORT=9100

# Server Host (default: 0.0.0.0)
HOST=0.0.0.0

# Node Environment (development|production|test)
NODE_ENV=development

# CORS Origin - Frontend URL (default: http://localhost:9000)
CORS_ORIGIN=http://localhost:9000

# ============================================================================
# FILE WATCHING
# ============================================================================

# Root directory to watch for file changes (default: parent directory)
# Example: /home/user/Projects or C:\Users\user\Projects
WATCH_PATH=/home/user/Projects

# Raven data directory (default: ../.raven)
# Example: /home/user/Projects/.raven
RAVEN_DIR=/home/user/Projects/.raven

# File watch debounce delay in milliseconds (default: 100)
FILE_WATCH_DEBOUNCE=100

# Maximum number of files to watch (default: 10000)
MAX_WATCHED_FILES=10000

# ============================================================================
# DATABASE
# ============================================================================

# Database path (default: .raven/raven.db)
DB_PATH=.raven/raven.db

# Developer database path (default: .raven/db/developer.db)
DEVELOPER_DB_PATH=.raven/db/developer.db

# Auth database path (default: .raven/db/auth.db)
AUTH_DB_PATH=.raven/db/auth.db

# Database directory (default: ./.raven/databases)
DB_DIR=./.raven/databases

# Snapshots directory (default: .raven/snapshots)
SNAPSHOTS_DIR=.raven/snapshots

# Snapshot retention in days (default: 30)
SNAPSHOT_RETENTION_DAYS=30
SNAPSHOT_TTL_DAYS=30

# ============================================================================
# WEBSOCKET
# ============================================================================

# WebSocket ping timeout in milliseconds (default: 60000)
WS_PING_TIMEOUT=60000

# WebSocket ping interval in milliseconds (default: 25000)
WS_PING_INTERVAL=25000

# ============================================================================
# RATE LIMITING
# ============================================================================

# General API rate limit window in milliseconds (default: 60000)
RATE_LIMIT_WINDOW_MS=60000

# General API max requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# API rate limit max (alternative name, default: 100)
API_RATE_LIMIT_MAX=100

# Telemetry rate limit (default: 1000)
TELEMETRY_RATE_LIMIT=1000
TELEMETRY_RATE_LIMIT_MAX=1000

# ============================================================================
# SECURITY
# ============================================================================
# Raven has NO authentication. The 127.0.0.1 default bind is the boundary.
# RAVEN_BIND=0.0.0.0 exposes everything Raven records to your network.
# RAVEN_BIND=127.0.0.1

# BCrypt rounds for password hashing (default: 10)
BCRYPT_ROUNDS=10

# Maximum request size (default: 10mb)
MAX_REQUEST_SIZE=10mb
JSON_PAYLOAD_LIMIT=10mb

# ============================================================================
# LOGGING
# ============================================================================

# Log level (debug|info|warn|error, default: info)
LOG_LEVEL=info

# Log format (json|text, default: json)
LOG_FORMAT=json

# Log directory (default: logs)
LOG_DIR=logs

# Maximum log files to keep (default: 30)
LOG_MAX_FILES=30

# Maximum log file size (default: 20m)
LOG_MAX_SIZE=20m

# Structured logging enabled (default: false)
STRUCTURED_LOGGING=false

# Show error details in responses (default: true in dev, false in prod)
SHOW_ERROR_DETAILS=true

# ============================================================================
# MONITORING & PERFORMANCE
# ============================================================================

# Enable metrics collection (default: true)
ENABLE_METRICS=true

# Enable triggers (default: true)
ENABLE_TRIGGERS=true

# Enable Git monitoring (default: true)
ENABLE_GIT_MONITOR=true

# Enable debug routes (default: false)
ENABLE_DEBUG_ROUTES=false

# Enable tracing (default: false)
ENABLE_TRACING=false

# Metrics collection interval in milliseconds (default: 5000)
METRICS_INTERVAL=5000

# Metrics export port (default: 9090)
METRICS_PORT=9090

# Health check interval in milliseconds (default: 30000)
HEALTH_CHECK_INTERVAL=30000

# Health check cache TTL in milliseconds (default: 5000)
HEALTH_CACHE_TTL=5000

# Log watcher poll interval in milliseconds (default: 100)
LOG_WATCHER_POLL_INTERVAL=100

# Slow request threshold in milliseconds (default: 1000)
SLOW_REQUEST_MS=1000

# Maximum response time in milliseconds (default: 5000)
MAX_RESPONSE_TIME_MS=5000

# Memory warning threshold in MB (default: 500)
MEMORY_WARNING_MB=500

# CPU warning threshold as percentage (default: 80)
CPU_WARNING_PERCENT=80

# ============================================================================
# CACHE
# ============================================================================

# Maximum cache size (default: 1000)
MAX_CACHE_SIZE=1000

# ============================================================================
# PLUGINS
# ============================================================================

# Enable plugin system (default: true)
ENABLE_PLUGINS=true

# Plugins directory (default: .raven/plugins)
PLUGINS_DIR=.raven/plugins

# Auto-load plugins on startup (default: true)
AUTO_LOAD_PLUGINS=true

# ============================================================================
# ACTIVE PROJECT
# ============================================================================

# Active project name (default: raven)
ACTIVE_PROJECT=raven

# ============================================================================
# FRONTEND CONFIGURATION (Vite)
# ============================================================================

# API URL for production builds (default: http://localhost:9100)
# Only used when building frontend for production
VITE_API_URL=http://localhost:9100

# WebSocket URL for frontend (default: uses VITE_API_URL)
VITE_WS_URL=http://localhost:9100
