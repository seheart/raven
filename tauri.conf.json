{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raven",
  "version": "0.5.0",
  "identifier": "io.raven.dev",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev",
    "beforeBuildCommand": "cd frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "frontend/dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first AI agent monitoring tool",
    "longDescription": "Raven captures file changes, system metrics, and API events in real time — without relying on GitHub. Built for Claude Code and other local AI development tools.",
    "category": "DeveloperTool",
    "homepage": "https://github.com/seheart/raven",
    "publisher": "Seth Eheart",
    "copyright": "Copyright © 2025 Seth Eheart. All rights reserved.",
    "license": "MIT",
    "licenseFile": "../LICENSE"
  },
  "app": {
    "windows": [
      {
        "title": "Raven - AI Agent Monitor",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
