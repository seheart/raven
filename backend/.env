# Raven Backend - Environment Configuration

# ==================== Server Configuration ====================
NODE_ENV=development
PORT=3030
CORS_ORIGIN=http://localhost:5173

# ==================== Authentication ====================
# Set to 'true' to disable JWT authentication (development only)
DISABLE_AUTH=true

# ==================== Logging ====================
LOG_LEVEL=info

# ==================== Database ====================
DB_DIR=./.raven/databases

# ==================== Performance ====================
JSON_PAYLOAD_LIMIT=10mb
MAX_CACHE_SIZE=1000

# ==================== Development ====================
SHOW_ERROR_DETAILS=true
