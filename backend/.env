# Raven Backend - Environment Configuration

# ==================== Server Configuration ====================
NODE_ENV=development
PORT=9100
CORS_ORIGIN=http://localhost:9000

# ==================== Authentication ====================
# Set to 'true' to disable JWT authentication (development only)
DISABLE_AUTH=true

# ==================== Logging ====================
LOG_LEVEL=info

# ==================== Database ====================
DB_DIR=./.raven/databases

# ==================== Performance ====================
JSON_PAYLOAD_LIMIT=10mb
MAX_CACHE_SIZE=1000

# ==================== Rate Limiting ====================
# General API Rate Limiting (optimized for monitoring tools)
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=10000

# Telemetry Rate Limiting
TELEMETRY_RATE_LIMIT_WINDOW_MS=60000
TELEMETRY_RATE_LIMIT_MAX=5000

# ==================== Development ====================
SHOW_ERROR_DETAILS=true
