{
  "name": "raven-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade backend for Raven AI monitoring with revolutionary log-based architecture",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "postinstall": "npm run build",
    "prebuild": "echo '📦 Building backend TypeScript...'",
    "build": "rm -rf dist && tsc",
    "prestart": "test -d dist || npm run build",
    "start": "node dist/server.js",
    "dev": "node --watch dist/server.js",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm run test -- --watch",
    "test:coverage": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --coverageReporters=text --coverageReporters=lcov --coverageReporters=html",
    "test:coverage:html": "npm run test:coverage && open coverage/lcov-report/index.html",
    "test:integration": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=integration",
    "test:perf": "node __tests__/performance/api-endpoints.perf.js",
    "lint:arch": "depcruise --config .dependency-cruiser.cjs .",
    "lint:arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot . | dot -T svg > dependency-graph.svg",
    "openapi:dump": "node scripts/dump-openapi.js",
    "lint:types": "type-coverage --ignore-catch --at-least 91.5",
    "lint:types:report": "type-coverage --ignore-catch --detail"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.9",
    "simple-git": "^3.28.0",
    "socket.io": "^4.8.1",
    "systeminformation": "^5.27.11",
    "toml": "^3.0.0",
    "winston": "^3.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.9.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autocannon": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-environment-node": "^30.3.0",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "validator": "^13.15.20",
    "uuid": "^14.0.0"
  }
}
