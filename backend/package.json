{
  "name": "raven-backend",
  "version": "1.0.0",
  "description": "Node.js backend for Raven AI monitoring",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:ts": "node dist/server.js",
    "dev": "node --watch server.js",
    "dev:ts": "tsc && node --watch dist/server.js",
    "build": "rm -rf dist && tsc",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "express": "^4.21.2",
    "marked": "^16.4.1",
    "simple-git": "^3.28.0",
    "socket.io": "^4.8.1",
    "systeminformation": "^5.27.11",
    "toml": "^3.0.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.8.1",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
