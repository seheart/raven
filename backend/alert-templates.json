{
  "templates": {
    "ai-safety-basic": {
      "name": "AI Safety (Recommended)",
      "description": "Essential alerts to keep your project safe while using AI coding assistants",
      "icon": "🛡️",
      "triggers": [
        {
          "id": "large-deletion",
          "type": "large_deletion",
          "name": "Large Code Deletion",
          "description": "Alert when AI deletes more than 100 lines at once",
          "threshold": 100,
          "severity": "warning",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": true,
            "message": "AI deleted {lines} lines in {file}"
          }
        },
        {
          "id": "security-file-change",
          "type": "security_file",
          "name": "Security File Modified",
          "description": "Alert when sensitive files are changed",
          "patterns": [".env*", ".git/config", "*.pem", "*.key", "credentials*"],
          "severity": "critical",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": true,
            "requireInteraction": true,
            "message": "⚠️ Security file changed: {file}"
          }
        },
        {
          "id": "dependency-change",
          "type": "dependency_change",
          "name": "Dependencies Modified",
          "description": "Alert when package files are updated",
          "patterns": ["package.json", "package-lock.json", "requirements.txt", "Cargo.toml", "go.mod"],
          "severity": "info",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": false,
            "message": "Dependencies updated in {file}"
          }
        },
        {
          "id": "massive-change",
          "type": "massive_change",
          "name": "Massive File Change",
          "description": "Alert when a single file changes by more than 500 lines",
          "threshold": 500,
          "severity": "warning",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": true,
            "message": "Huge change detected: {lines} lines in {file}"
          }
        },
        {
          "id": "rapid-changes",
          "type": "rapid_changes",
          "name": "Rapid Consecutive Changes",
          "description": "Alert when the same file is modified 5+ times in 60 seconds",
          "threshold": 5,
          "windowSeconds": 60,
          "severity": "info",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": false,
            "message": "AI is rapidly changing {file} - possible issue?"
          }
        }
      ]
    },
    "paranoid": {
      "name": "Maximum Protection",
      "description": "Alert on every change - best for learning or high-stakes projects",
      "icon": "🚨",
      "triggers": [
        {
          "id": "all-deletions",
          "type": "any_deletion",
          "name": "Any Deletion",
          "description": "Alert on any line deletion, no matter how small",
          "threshold": 1,
          "severity": "info",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": false,
            "message": "Lines deleted in {file}"
          }
        },
        {
          "id": "all-new-files",
          "type": "file_created",
          "name": "New File Created",
          "description": "Alert when AI creates any new file",
          "severity": "info",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": false,
            "message": "New file created: {file}"
          }
        },
        {
          "id": "all-file-changes",
          "type": "file_modified",
          "name": "File Modified",
          "description": "Alert on every file modification",
          "severity": "info",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": false,
            "message": "File modified: {file}"
          }
        }
      ]
    },
    "minimal": {
      "name": "Just the Essentials",
      "description": "Only alert on critical issues - for experienced users",
      "icon": "✅",
      "triggers": [
        {
          "id": "catastrophic-deletion",
          "type": "large_deletion",
          "name": "Catastrophic Deletion",
          "description": "Alert only on massive deletions (500+ lines)",
          "threshold": 500,
          "severity": "critical",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": true,
            "requireInteraction": true,
            "message": "🚨 CRITICAL: {lines} lines deleted in {file}!"
          }
        },
        {
          "id": "security-only",
          "type": "security_file",
          "name": "Security Files Only",
          "description": "Alert only on security-sensitive files",
          "patterns": [".env*", ".git/config", "*.pem", "*.key"],
          "severity": "critical",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": true,
            "requireInteraction": true,
            "message": "⚠️ Security file changed: {file}"
          }
        }
      ]
    },
    "test-focused": {
      "name": "Test Safety",
      "description": "Focus on protecting tests and preventing regressions",
      "icon": "🧪",
      "triggers": [
        {
          "id": "test-deletion",
          "type": "test_file_change",
          "name": "Test File Deleted/Modified",
          "description": "Alert when test files are changed",
          "patterns": ["*.test.*", "*.spec.*", "*_test.*", "test_*"],
          "severity": "warning",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": true,
            "message": "Test file changed: {file}"
          }
        },
        {
          "id": "coverage-drop",
          "type": "coverage_change",
          "name": "Test Coverage Changed",
          "description": "Alert when test coverage files are modified",
          "patterns": ["coverage/**", ".coverage", "htmlcov/**"],
          "severity": "info",
          "enabled": true,
          "notification": {
            "desktop": true,
            "sound": false,
            "message": "Test coverage data changed"
          }
        }
      ]
    }
  },
  "metadata": {
    "version": "1.0.0",
    "recommended": "ai-safety-basic",
    "description": "Pre-configured alert templates for AI coding safety"
  }
}
