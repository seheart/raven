{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,

    // Strict Type-Checking Options (Full strict mode enabled)
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,

    // Additional Checks (Production-grade configuration)
    "noUnusedLocals": true,
    "noUnusedParameters": false, // Express routes require req parameter even when unused
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": false,

    // Module Resolution
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,

    // Emit Options
    "removeComments": false,
    "preserveConstEnums": true,
    "isolatedModules": true
  },
  "include": ["**/*.ts", "repositories/**/*.ts", "services/**/*.ts", "utils/**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "dist", "__tests__", "**/*.test.js", "**/*.test.ts"]
}
