# Raven Backend - Environment Configuration
# Copy this file to .env and customize for your environment

# ==================== Server Configuration ====================
NODE_ENV=development
PORT=3030
CORS_ORIGIN=http://localhost:5173

# ==================== Authentication ====================
# Set to 'true' to disable JWT authentication (development only)
DISABLE_AUTH=true

# JWT Secret (REQUIRED in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT Expiration (default: 24h)
JWT_EXPIRES_IN=24h

# ==================== Logging ====================
# Levels: debug, info, warn, error
LOG_LEVEL=info

# ==================== Database ====================
# Database directory
DB_DIR=./.raven/databases

# Snapshot retention (days)
SNAPSHOT_TTL_DAYS=30

# ==================== Performance ====================
# JSON payload size limit
JSON_PAYLOAD_LIMIT=10mb

# File cache size
MAX_CACHE_SIZE=1000

# Health cache TTL (milliseconds)
HEALTH_CACHE_TTL=5000

# ==================== Rate Limiting ====================
# API rate limit (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Telemetry rate limit
TELEMETRY_RATE_LIMIT=1000

# ==================== Projects ====================
# Active project (default)
ACTIVE_PROJECT=raven

# ==================== Features ====================
# Enable/disable features
ENABLE_METRICS=true
ENABLE_TRIGGERS=true
ENABLE_GIT_MONITOR=true

# ==================== External Services ====================
# Add any external service URLs here
# EXTERNAL_API_URL=https://api.example.com

# ==================== Observability (Phase 5C) ====================
# Enable structured logging
STRUCTURED_LOGGING=false

# Enable request tracing
ENABLE_TRACING=false

# Metrics endpoint (Prometheus)
METRICS_PORT=9090

# ==================== Security ====================
# Allowed origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173,https://raven.example.com

# Max request body size
# MAX_REQUEST_SIZE=10mb

# ==================== Development ====================
# Show detailed error messages (development only)
SHOW_ERROR_DETAILS=true

# Enable debug routes
ENABLE_DEBUG_ROUTES=false
