# Runtime data - Database files and local config
/.raven/db/*.db
/.raven/db/*.db-shm
/.raven/db/*.db-wal
/.raven/db/*.db-journal
/.raven/snapshots/*
/.raven/*.log
/.raven/raven.db
/.raven/projects.json
/.raven/projects.json.bak
/.raven/log-positions-*.json
/.raven/host.json
/.raven/peers.json

# Backend database files (avoid duplicate/orphaned files)
/backend/*.db
/backend/*.db-shm
/backend/*.db-wal
/backend/*.db-journal
/backend/.raven/

# Backend logs
/backend/logs/
/backend/*.log

# Backend build artifacts
/backend/dist/
/backend/coverage/

# Keep .raven structure
!/.raven/.gitkeep
!/.raven/db/.gitkeep
!/.raven/snapshots/.gitkeep

# Frontend
/frontend/node_modules
/frontend/dist
/frontend/.svelte-kit
/frontend/build
# Vitest's HTML report (vitest.config.js reporter: [..., 'html']). Every
# `npm run test:run` rewrites the whole directory, and the assets are
# content-hashed, so each run dirties index.html and leaves a fresh pair of
# index-*.js/css behind while the committed ones go stale. Only the meta
# artifact was untracked originally; the rest of the directory had the same
# problem and kept the Health Monitor's "uncommitted changes" check warning.
/frontend/html/

# Old frontend (Svelte 4) - retired after migration to Svelte 5
/frontend-svelte4/

# Environment files (SECURITY: Never commit secrets)
.env
.env.local
.env.*.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp

# Logs
*.log

# Test workspace changes (optional - comment out if you want to track test changes)
/test_workspace/**
!/test_workspace/README.md
.raven/.jwt-secret

# Test output
**/test-results.json

# Playwright test artifacts
playwright-report/
test-results/

# Nightly test logs
logs/nightly-tests/
/raven.db
.raven/
