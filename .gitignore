# Runtime data - Database files
/.raven/db/*.db
/.raven/db/*.db-shm
/.raven/db/*.db-wal
/.raven/db/*.db-journal
/.raven/snapshots/*
/.raven/*.log

# Backend database files (avoid duplicate/orphaned files)
/backend/*.db
/backend/*.db-shm
/backend/*.db-wal
/backend/*.db-journal
/backend/.raven/

# Backend logs
/backend/logs/
/backend/*.log

# Backend build artifacts
/backend/dist/
/backend/coverage/

# Keep .raven structure
!/.raven/.gitkeep
!/.raven/db/.gitkeep
!/.raven/snapshots/.gitkeep

# Frontend
/frontend/node_modules
/frontend/dist
/frontend/.svelte-kit
/frontend/build

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Test workspace changes (optional - comment out if you want to track test changes)
/test_workspace/**
!/test_workspace/README.md
.raven/.jwt-secret

# Playwright test artifacts
playwright-report/
test-results/

# Nightly test logs
logs/nightly-tests/
