#!/bin/bash

# Raven - Smart CLI Launcher
# Usage: raven [start|stop|restart|status|logs]

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

RAVEN_DIR="/home/seth/Projects/raven"
BACKEND_PORT=9100
FRONTEND_PORT=9000

# Check if Raven is running
is_running() {
    # Check if both backend and frontend ports are listening
    if ss -tlnp 2>/dev/null | grep -q ":$BACKEND_PORT " && \
       ss -tlnp 2>/dev/null | grep -q ":$FRONTEND_PORT "; then
        return 0
    else
        return 1
    fi
}

# Get PIDs for ports
get_pid() {
    local port=$1
    ss -tlnp 2>/dev/null | grep ":$port " | grep -oP 'pid=\K[0-9]+' | head -1 || echo "unknown"
}

# Get status
get_status() {
    if is_running; then
        BACKEND_PID=$(get_pid $BACKEND_PORT)
        FRONTEND_PID=$(get_pid $FRONTEND_PORT)
        echo -e "${GREEN}✓ Raven is running${NC}"
        echo -e "  Backend:  http://localhost:$BACKEND_PORT (PID: $BACKEND_PID)"
        echo -e "  Frontend: http://localhost:$FRONTEND_PORT (PID: $FRONTEND_PID)"
        return 0
    else
        echo -e "${RED}✗ Raven is not running${NC}"
        return 1
    fi
}

# Start Raven
start_raven() {
    if is_running; then
        echo -e "${YELLOW}⚠ Raven is already running${NC}"
        get_status
        return 0
    fi

    echo -e "${CYAN}🚀 Starting Raven...${NC}"
    cd "$RAVEN_DIR"
    ./start-fast.sh
}

# Stop Raven
stop_raven() {
    if ! is_running; then
        echo -e "${YELLOW}⚠ Raven is not running${NC}"
        return 0
    fi

    echo -e "${CYAN}🛑 Stopping Raven...${NC}"
    cd "$RAVEN_DIR"
    ./stop.sh
}

# Restart Raven
restart_raven() {
    echo -e "${CYAN}🔄 Restarting Raven...${NC}"
    cd "$RAVEN_DIR"
    ./restart.sh
}

# Show logs
show_logs() {
    echo -e "${CYAN}📋 Raven Logs${NC}"
    echo -e "${YELLOW}Backend log:${NC} /tmp/raven-backend.log"
    echo -e "${YELLOW}Frontend log:${NC} /tmp/raven-frontend.log"
    echo ""
    echo -e "${BLUE}Tailing both logs (Ctrl+C to exit)...${NC}"
    tail -f /tmp/raven-backend.log /tmp/raven-frontend.log 2>/dev/null || \
        echo -e "${RED}No logs found. Start Raven first.${NC}"
}

# Run health checks
run_health_check() {
    if ! is_running; then
        echo -e "${RED}❌ Raven is not running${NC}"
        echo -e "${YELLOW}Start Raven first with: raven start${NC}"
        return 1
    fi

    echo -e "${CYAN}🏥 Running health validation...${NC}"
    cd "$RAVEN_DIR/backend"
    node scripts/run-startup-validation.js
    cd - > /dev/null
}

# Open browser
open_browser() {
    echo -e "${CYAN}🌐 Opening Raven in browser...${NC}"
    xdg-open "http://localhost:$FRONTEND_PORT" 2>/dev/null || \
        echo -e "${RED}Could not open browser. Visit http://localhost:$FRONTEND_PORT manually.${NC}"
}

# Run all tests
run_tests() {
    echo -e "${CYAN}🧪 Running Raven Test Suite${NC}"
    echo ""

    local total_failures=0

    # Backend Tests (only new passing tests)
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}1️⃣  Backend Unit Tests (Jest)${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    cd "$RAVEN_DIR/backend"
    npm test -- __tests__/routes/notifications.test.js __tests__/routes/endpoints.test.js __tests__/routes/errors.test.js __tests__/routes/events.test.js __tests__/routes/sync.test.js 2>&1 | tail -10
    local backend_status=$?
    if [ $backend_status -ne 0 ]; then ((total_failures++)); fi
    echo ""

    # Frontend Unit Tests
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}2️⃣  Frontend Unit Tests (Vitest)${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    cd "$RAVEN_DIR/frontend"
    npm run test:run 2>&1 | tail -20
    local frontend_status=$?
    if [ $frontend_status -ne 0 ]; then ((total_failures++)); fi
    echo ""

    # E2E Tests (optional - can be slow)
    if [ "${SKIP_E2E:-false}" != "true" ]; then
        echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${YELLOW}3️⃣  E2E Tests (Playwright)${NC}"
        echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${CYAN}ℹ️  Set SKIP_E2E=true to skip E2E tests${NC}"
        npm run test:e2e 2>&1 | tail -20
        local e2e_status=$?
        if [ $e2e_status -ne 0 ]; then ((total_failures++)); fi
        echo ""
    else
        echo -e "${YELLOW}⏭️  Skipping E2E tests (SKIP_E2E=true)${NC}"
        echo ""
    fi

    cd - > /dev/null

    # Summary
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${CYAN}📊 Test Suite Summary${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    if [ $total_failures -eq 0 ]; then
        echo -e "${GREEN}✅ All test suites passed!${NC}"
        echo ""
        echo -e "  ${GREEN}✓${NC} Backend unit tests"
        echo -e "  ${GREEN}✓${NC} Frontend unit tests"
        [ "${SKIP_E2E:-false}" != "true" ] && echo -e "  ${GREEN}✓${NC} E2E tests"
        echo ""
        echo -e "${CYAN}💡 Additional commands:${NC}"
        echo -e "  ${YELLOW}npm run test:perf${NC}     - Run performance tests (in backend/)"
        echo -e "  ${YELLOW}npm run test:coverage${NC} - Generate coverage reports"
        return 0
    else
        echo -e "${RED}❌ $total_failures test suite(s) failed${NC}"
        echo ""
        echo -e "${CYAN}💡 Run individual suites:${NC}"
        echo -e "  ${YELLOW}cd backend && npm test${NC}"
        echo -e "  ${YELLOW}cd frontend && npm run test:run${NC}"
        echo -e "  ${YELLOW}cd frontend && npm run test:e2e${NC}"
        return 1
    fi
}

# Main command handler
case "${1:-open}" in
    start)
        start_raven
        ;;
    stop)
        stop_raven
        ;;
    restart)
        restart_raven
        ;;
    status)
        get_status
        ;;
    logs)
        show_logs
        ;;
    check)
        run_health_check
        ;;
    test)
        run_tests
        ;;
    open|browser)
        if is_running; then
            echo -e "${GREEN}✓ Raven is already running${NC}"
            open_browser
        else
            echo -e "${YELLOW}⚠ Raven is not running. Starting it now...${NC}"
            start_raven
            sleep 1
            open_browser
        fi
        ;;
    help|--help|-h)
        echo -e "${CYAN}Raven - Smart CLI Launcher${NC}"
        echo ""
        echo "Usage: raven [command]"
        echo ""
        echo "Commands:"
        echo "  (no args)   Open Raven in browser (starts if needed)"
        echo "  start       Start Raven servers"
        echo "  stop        Stop Raven servers"
        echo "  restart     Restart Raven servers"
        echo "  status      Show running status"
        echo "  check       Run health validation"
        echo "  test        Run all tests (backend + frontend + E2E)"
        echo "  logs        Tail server logs"
        echo "  open        Open in browser (starts if needed)"
        echo "  help        Show this help"
        echo ""
        echo "Examples:"
        echo "  raven              # Quick open in browser"
        echo "  raven start        # Start servers only"
        echo "  raven status       # Check if running"
        echo "  raven check        # Validate all systems"
        echo "  raven test         # Run all tests (backend + frontend + E2E)"
        echo "  SKIP_E2E=true raven test  # Skip slow E2E tests"
        echo "  raven logs         # View logs"
        ;;
    *)
        # Default: open in browser (smart start)
        if is_running; then
            echo -e "${GREEN}✓ Raven is already running${NC}"
            open_browser
        else
            echo -e "${YELLOW}⚠ Raven is not running. Starting it now...${NC}"
            start_raven
            sleep 1
            open_browser
        fi
        ;;
esac
