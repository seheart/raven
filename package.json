{
  "name": "raven",
  "version": "1.0.0",
  "description": "Local-first AI agent monitoring tool - Web version",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm start",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "./start.sh",
    "stop": "./stop.sh",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm run test:run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "playwright:install": "playwright install --with-deps",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "svelte",
    "nodejs",
    "monitoring",
    "ai-agents",
    "web-app"
  ],
  "author": "Seth Eheart",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "concurrently": "^9.1.2",
    "glob": "^11.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "playwright": "^1.58.1"
  }
}
