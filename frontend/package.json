{
  "name": "raven-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pages": "node test-all-pages.js",
    "test:all": "npm run test:run && npm run test:pages",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{css,svelte}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,svelte}\" --fix",
    "lint:html": "html-validate \"src/**/*.svelte\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:patterns": "bash scripts/validate-patterns.sh",
    "validate:design-coverage": "bash scripts/check-design-system-coverage.sh",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "validate": "npm run check && npm run lint && npm run lint:css && npm run validate:patterns && npm run validate:design-coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "openapi:gen": "openapi-typescript ../backend/config/openapi.json -o src/lib/api-types.d.ts",
    "lint:types": "type-coverage --ignore-catch --at-least 88.5",
    "lint:types:report": "type-coverage --ignore-catch --detail"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.2.9",
    "@tsconfig/svelte": "^5.0.6",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.12.4",
    "html-validate": "^10.2.1",
    "jsdom": "^27.2.0",
    "msw": "^2.12.2",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.56.1",
    "postcss": "^8.5.10",
    "postcss-html": "^1.8.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "stylelint": "^16.25.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^39.0.1",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.3",
    "tailwindcss": "^4.1.17",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dompurify": "^3.3.0",
    "mermaid": "^11.14.0",
    "socket.io-client": "^4.8.1"
  },
  "overrides": {
    "uuid": "^14.0.0"
  }
}
