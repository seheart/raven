# Raven Frontend Environment Variables
# Copy this file to .env.local and configure for your environment

# ==================== API Configuration ====================

# Backend API Base URL
# In development, Vite proxy handles this automatically (proxies to localhost:9100)
# In production, set this to your backend server URL
# VITE_API_BASE=http://localhost:9100/api

# WebSocket URL for real-time updates
# Default: http://localhost:9100
# VITE_WS_URL=http://localhost:9100

# ==================== Notes ====================

# 1. Variables prefixed with VITE_ are exposed to the client
# 2. In development mode, the Vite proxy (vite.config.js) handles API routing
# 3. Most of the time, you don't need to set these - defaults work for local development
# 4. Only customize these when:
#    - Connecting to a remote backend server
#    - Running in production
#    - Backend is on a non-standard port

# ==================== Production Example ====================

# For production deployment:
# VITE_API_BASE=https://your-backend-domain.com/api
# VITE_WS_URL=https://your-backend-domain.com
