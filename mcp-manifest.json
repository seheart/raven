{
  "name": "raven",
  "version": "0.6.0",
  "description": "Local-first AI agent monitoring and observability platform",
  "author": "Seth Eheart",
  "license": "MIT",
  "mcp_version": "1.0",
  "capabilities": {
    "tools": true,
    "resources": true,
    "prompts": false
  },
  "tools": [
    {
      "name": "raven.timeline",
      "description": "Query file change history and timeline",
      "input_schema": {
        "type": "object",
        "properties": {
          "filepath": {
            "type": "string",
            "description": "Path to the file to query history for"
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of events to return",
            "default": 50
          },
          "include_diff": {
            "type": "boolean",
            "description": "Include diff content in results",
            "default": false
          }
        }
      },
      "endpoint": "http://localhost:3030/api/file-events"
    },
    {
      "name": "raven.git",
      "description": "Get git repository status, diffs, and commit history",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["status", "diff", "history", "branches"],
            "description": "Git action to perform"
          },
          "limit": {
            "type": "number",
            "description": "For history: number of commits to return",
            "default": 10
          }
        },
        "required": ["action"]
      },
      "endpoints": {
        "status": "http://localhost:3030/api/git/status",
        "diff": "http://localhost:3030/api/git/diff",
        "history": "http://localhost:3030/api/git/history",
        "branches": "http://localhost:3030/api/git/branches"
      }
    },
    {
      "name": "raven.snapshot",
      "description": "Retrieve file snapshots from any point in time",
      "input_schema": {
        "type": "object",
        "properties": {
          "filepath": {
            "type": "string",
            "description": "Path to the file"
          },
          "timestamp": {
            "type": "string",
            "description": "ISO timestamp of desired snapshot (optional)"
          }
        },
        "required": ["filepath"]
      },
      "endpoint": "http://localhost:3030/api/snapshots/{filepath}"
    },
    {
      "name": "raven.telemetry",
      "description": "Get system metrics (CPU, memory, network) and performance data",
      "input_schema": {
        "type": "object",
        "properties": {
          "metric_type": {
            "type": "string",
            "enum": ["system", "process", "stats", "correlations"],
            "description": "Type of metrics to retrieve"
          },
          "agent": {
            "type": "string",
            "description": "Agent name (for process metrics)"
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of metric samples",
            "default": 100
          },
          "start_time": {
            "type": "string",
            "description": "Start time for stats (ISO format)"
          },
          "end_time": {
            "type": "string",
            "description": "End time for stats (ISO format)"
          }
        },
        "required": ["metric_type"]
      },
      "endpoints": {
        "system": "http://localhost:3030/api/system-metrics",
        "process": "http://localhost:3030/api/process-metrics/{agent}",
        "stats": "http://localhost:3030/api/metrics-stats",
        "correlations": "http://localhost:3030/api/performance-correlations"
      }
    },
    {
      "name": "raven.triggers",
      "description": "Manage custom alert triggers and view fired events",
      "input_schema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["config", "events", "stats", "reload", "clear"],
            "description": "Trigger action to perform"
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of events to return",
            "default": 100
          }
        },
        "required": ["action"]
      },
      "endpoints": {
        "config": "http://localhost:3030/api/triggers-config",
        "events": "http://localhost:3030/api/triggered-events",
        "stats": "http://localhost:3030/api/trigger-stats",
        "reload": "http://localhost:3030/api/triggers-reload",
        "clear": "http://localhost:3030/api/triggers-clear-cooldowns"
      }
    },
    {
      "name": "raven.agents",
      "description": "Query AI agent status, events, and statistics",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "enum": ["status", "events", "stats", "by_agent"],
            "description": "Type of agent data to retrieve"
          },
          "agent": {
            "type": "string",
            "description": "Specific agent name (for by_agent query)"
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of events to return",
            "default": 100
          }
        },
        "required": ["query"]
      },
      "endpoints": {
        "status": "http://localhost:3030/api/agents-status",
        "events": "http://localhost:3030/api/agent-events",
        "stats": "http://localhost:3030/api/agent-stats",
        "by_agent": "http://localhost:3030/api/events-by-agent/{agent}"
      }
    },
    {
      "name": "raven.dashboard",
      "description": "Get dashboard overview statistics and summaries",
      "input_schema": {
        "type": "object",
        "properties": {
          "view": {
            "type": "string",
            "enum": ["stats", "top_files", "longest_edits"],
            "description": "Dashboard view to retrieve"
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of items to return",
            "default": 10
          }
        },
        "required": ["view"]
      },
      "endpoints": {
        "stats": "http://localhost:3030/api/dashboard-stats",
        "top_files": "http://localhost:3030/api/top-modified-files",
        "longest_edits": "http://localhost:3030/api/longest-edits"
      }
    }
  ],
  "resources": [
    {
      "name": "raven.session",
      "description": "Current Raven session information",
      "uri": "http://localhost:3030/api/session-id",
      "mime_type": "application/json"
    },
    {
      "name": "raven.health",
      "description": "Raven backend health status",
      "uri": "http://localhost:3030/health",
      "mime_type": "application/json"
    },
    {
      "name": "raven.tracked_files",
      "description": "List of all tracked files",
      "uri": "http://localhost:3030/api/tracked-files",
      "mime_type": "application/json"
    }
  ],
  "configuration": {
    "backend_url": "http://localhost:3030",
    "frontend_url": "http://localhost:5173",
    "watch_path": "../test_workspace",
    "database_path": ".raven/db/raven.db",
    "snapshots_enabled": true,
    "metrics_enabled": true,
    "git_enabled": true
  },
  "usage_examples": [
    {
      "tool": "raven.timeline",
      "description": "Get recent file changes",
      "example": {
        "limit": 20,
        "include_diff": false
      }
    },
    {
      "tool": "raven.git",
      "description": "Check git status",
      "example": {
        "action": "status"
      }
    },
    {
      "tool": "raven.telemetry",
      "description": "Get system metrics",
      "example": {
        "metric_type": "system",
        "limit": 50
      }
    },
    {
      "tool": "raven.agents",
      "description": "List active agents",
      "example": {
        "query": "status"
      }
    }
  ],
  "documentation": {
    "readme": "https://github.com/seheart/raven/blob/main/README.md",
    "architecture": "https://github.com/seheart/raven/blob/main/ARCHITECTURE.md",
    "api_docs": "https://github.com/seheart/raven/tree/main/docs"
  }
}
